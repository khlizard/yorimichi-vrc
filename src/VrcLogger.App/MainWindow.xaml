<Window x:Class="VrcLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VrcLogger.App.Views"
        Title="{Binding WindowTitle, Mode=OneWay}" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="再取り込み" Padding="10,3"
                        Command="{Binding ImportCommand}" />
                <TextBlock DockPanel.Dock="Left" Text="期間:" VerticalAlignment="Center" Margin="16,0,4,0" />
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding DateFrom}" Width="130" />
                <TextBlock DockPanel.Dock="Left" Text="〜" VerticalAlignment="Center" Margin="4,0" />
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding DateTo}" Width="130" />
                <Button DockPanel.Dock="Left" Content="クリア" Margin="6,0,0,0" Padding="8,3"
                        Click="ClearDates_Click" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#555" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="4">
            <TabItem Header="プレイヤー">
                <views:PlayersView DataContext="{Binding Players}" />
            </TabItem>
            <TabItem Header="セッション">
                <views:SessionsView DataContext="{Binding Sessions}" />
            </TabItem>
            <TabItem Header="URL">
                <views:UrlsView DataContext="{Binding Urls}" />
            </TabItem>
            <TabItem Header="生ログ">
                <views:LogsView DataContext="{Binding Logs}" />
            </TabItem>
            <TabItem Header="設定">
                <views:SettingsView DataContext="{Binding SettingsTab}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
