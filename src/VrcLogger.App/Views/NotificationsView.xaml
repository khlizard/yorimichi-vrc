<UserControl x:Class="VrcLogger.App.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="検索" Padding="10,3" Margin="6,0,0,0"
                    Command="{Binding SearchCommand}" />
            <ComboBox DockPanel.Dock="Right" Width="120" Margin="6,0,0,0"
                      ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding EventTime}" Width="150" />
                <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="110" />
                <DataGridTextColumn Header="送信者" Binding="{Binding SenderName}" Width="180" />
                <DataGridTextColumn Header="本文" Binding="{Binding Message}" Width="2*" />
                <DataGridTextColumn Header="詳細" Binding="{Binding Details}" Width="*" />
                <DataGridTextColumn Header="応答" Binding="{Binding Response}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="4" />

        <TextBlock Grid.Row="3" Text="モデレーション (ミュート / ブロック / Vote Kick)" FontWeight="Bold" Margin="0,6,0,2" />
        <DataGrid Grid.Row="4" x:Name="ModerationGrid" ItemsSource="{Binding Moderation}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  MouseDoubleClick="ModerationGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding EventTime}" Width="150" />
                <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="対象" Binding="{Binding TargetName}" Width="220" />
                <DataGridTextColumn Header="ワールド" Binding="{Binding WorldName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
