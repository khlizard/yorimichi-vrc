<UserControl x:Class="VrcLogger.App.Views.AvatarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="検索" Padding="10,3" Margin="6,0,0,0"
                    Command="{Binding SearchCommand}" />
            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" ToolTip="アバター名またはプレイヤー名">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="#777" FontSize="11" Margin="0,4,0,0"
                   Text="サイズはダウンロードした時だけ記録されます (キャッシュ済みのアバターは空欄)。ダブルクリックでセッションへ。" />
        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  MouseDoubleClick="ResultGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding EventTime}" Width="150" />
                <DataGridTextColumn Header="プレイヤー" Binding="{Binding DisplayName}" Width="180" />
                <DataGridTextColumn Header="アバター" Binding="{Binding AvatarName}" Width="*" />
                <DataGridTextColumn Header="サイズ (MB)" Binding="{Binding SizeMb, StringFormat={}{0:0.0}}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DL 秒" Binding="{Binding LoadSeconds}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ワールド" Binding="{Binding WorldName}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
