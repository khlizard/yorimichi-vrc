<UserControl x:Class="VrcLogger.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="検索" Padding="10,3" Margin="6,0,0,0"
                    Command="{Binding SearchCommand}" />
            <ComboBox DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"
                      ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  MouseDoubleClick="ResultGrid_MouseDoubleClick"
                  ScrollViewer.ScrollChanged="List_ScrollChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding EventTime}" Width="150" />
                <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="70" />
                <DataGridTextColumn Header="ワールド" Binding="{Binding WorldName}" Width="180" />
                <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
