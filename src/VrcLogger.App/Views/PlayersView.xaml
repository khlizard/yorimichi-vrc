<UserControl x:Class="VrcLogger.App.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="検索" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SearchCommand}" />
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock>
                                <Run Text="{Binding DisplayName}" FontWeight="Bold" />
                                <Run Text="{Binding EncounterCount, StringFormat=({0}回)}" Foreground="#777" />
                            </TextBlock>
                            <TextBlock Text="{Binding OtherNames, StringFormat=aka {0}}" Foreground="#999"
                                       FontSize="11" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OtherNames}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

        <DataGrid x:Name="EncounterGrid" Grid.Column="2" ItemsSource="{Binding Encounters}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  MouseDoubleClick="EncounterGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="会った日時" Binding="{Binding JoinTime}" Width="150" />
                <DataGridTextColumn Header="別れた日時" Binding="{Binding LeaveTime}" Width="150" />
                <DataGridTextColumn Header="滞在" Binding="{Binding Duration}" Width="80" />
                <DataGridTextColumn Header="名前(当時)" Binding="{Binding DisplayName}" Width="140" />
                <DataGridTextColumn Header="アバター" Binding="{Binding AvatarName}" Width="180" />
                <DataGridTextColumn Header="MB" Binding="{Binding AvatarSizeMb, StringFormat={}{0:0.0}}" Width="55" />
                <DataGridTextColumn Header="ワールド" Binding="{Binding WorldName}" Width="200" />
                <DataGridTextColumn Header="インスタンス" Binding="{Binding InstanceId}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
