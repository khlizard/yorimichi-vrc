<UserControl x:Class="VrcLogger.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="ワールド名:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding WorldFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         VerticalContentAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Visits}" SelectedItem="{Binding SelectedVisit}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock>
                                <Run Text="{Binding JoinTime}" Foreground="#777" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding WorldName}" FontWeight="Bold" />
                                <Run Text="{Binding PlayerCount, StringFormat=({0}人)}" Foreground="#777" />
                                <Run Text="{Binding Duration, Mode=OneWay}" Foreground="#777" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding SelectedVisit.WorldName}" />
                <TextBlock Foreground="#777" TextWrapping="Wrap" Text="{Binding SelectedVisit.Location}" />
                <TextBlock Foreground="#777">
                    <Run Text="{Binding SelectedVisit.JoinTime}" />
                    <Run Text="〜" />
                    <Run Text="{Binding SelectedVisit.LeaveTime}" />
                    <Run Text="{Binding SelectedVisit.Duration, Mode=OneWay, StringFormat=({0})}" />
                </TextBlock>
                <CheckBox Content="自分を隠す" IsChecked="{Binding HideLocalPlayer}" Margin="0,4,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding VisitPlayers}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                <Setter Property="Background" Value="#FFF7DE" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名前" Binding="{Binding DisplayName}" Width="200" />
                    <DataGridTextColumn Header="アバター" Binding="{Binding AvatarName}" Width="*" />
                    <DataGridTextColumn Header="MB" Binding="{Binding AvatarSizeMb, StringFormat={}{0:0.0}}" Width="55" />
                    <DataGridTextColumn Header="Join" Binding="{Binding JoinTime}" Width="140" />
                    <DataGridTextColumn Header="Leave" Binding="{Binding LeaveTime}" Width="140" />
                    <DataGridTextColumn Header="滞在" Binding="{Binding Duration}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="4" />

            <TextBlock Grid.Row="3" Text="URLイベント" FontWeight="Bold" Margin="0,6,0,2" />
            <DataGrid Grid.Row="4" ItemsSource="{Binding VisitUrls}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                      PreviewKeyDown="UrlGrid_PreviewKeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="URL をコピー" Click="CopyUrl_Click" InputGestureText="Ctrl+C" />
                        <MenuItem Header="行をコピー (時刻・種別・URL)" Click="CopyRow_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時刻" Binding="{Binding EventTime}" Width="150" />
                    <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="60" />
                    <DataGridTemplateColumn Header="URL" Width="*" ClipboardContentBinding="{Binding Url}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{Binding Url}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
