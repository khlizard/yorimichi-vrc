{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev",
            "detail": "アプリを開発モードで起動 (pnpm tauri dev)",
            "type": "shell",
            "command": "pnpm tauri dev",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "test",
            "detail": "Rust のテスト (pnpm test:rust)",
            "type": "shell",
            "command": "pnpm test:rust",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$rustc"
        },
        {
            "label": "build",
            "detail": "リリース版 exe をビルド (pnpm tauri build --no-bundle)",
            "type": "shell",
            "command": "pnpm tauri build --no-bundle",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$rustc"
        },
        {
            "label": "pack",
            "detail": "Velopack のインストーラーを作成 (scripts/pack.ps1)",
            "type": "shell",
            "command": "pwsh -NoProfile -File scripts/pack.ps1",
            "problemMatcher": []
        }
    ]
}
